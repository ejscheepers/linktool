# Copy to .env for local development. Production values are set in Coolify.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173
DATABASE_PATH=./data/database.sqlite
UPLOAD_DIR=./data/uploads
APP_TIMEZONE=Africa/Johannesburg
PORT=8000
NODE_ENV=production

# Optional. Full URL of an extra host the app answers on, if it differs from
# BETTER_AUTH_URL (the origin allow-lists are derived from BETTER_AUTH_URL).
# PRIMARY_HOST=https://link.example.com

# Optional. Only needed for extra domains/origins beyond the primary host.
# ALLOWED_ACTION_ORIGINS=https://link.example.com
# TRUSTED_ORIGINS=https://link.example.com
