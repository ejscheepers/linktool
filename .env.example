# Copy to .env for local development. Production values are set in Coolify.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads
APP_TIMEZONE=Africa/Johannesburg
PORT=8000
NODE_ENV=production

# Optional. Only needed for extra domains/origins beyond the primary host.
# ALLOWED_ACTION_ORIGINS=https://links.dailywine.co.za
# TRUSTED_ORIGINS=https://links.dailywine.co.za
